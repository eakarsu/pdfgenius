{
  "name": "pdfgenius",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.1.3",
    "sequelize": "^6.37.5",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "prestart": "node scripts/assert-local-prototype.js",
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "prepreview": "node scripts/assert-local-prototype.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "preserver": "node scripts/assert-local-prototype.js",
    "server": "nodemon --watch src --watch server.js server.js",
    "predev": "node scripts/assert-local-prototype.js",
    "dev": "concurrently \"npm run server\" \"npm run start\"",
    "seed": "node scripts/blocked-operation.js seed",
    "db:sync": "node scripts/blocked-operation.js db:sync",
    "migrate": "node scripts/migrate-local-fixture.js",
    "create-admin": "node scripts/create-local-auth-fixture.js",
    "check:boundary": "node scripts/verify-prototype-boundary.js",
    "check:security": "bash scripts/security-audit.sh",
    "verify": "npm run check:boundary && npm test && npm run build"
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.11",
    "vite": "^5.4.11"
  }
}
